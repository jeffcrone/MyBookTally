{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 25,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"description": "Shared settings: Ninja, one build folder per preset under build/.",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/dist/${presetName}",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"MYBOOKTALLY_BUILD_TESTS": "ON"
			}
		},
		{
			"name": "linux-base",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "linux-debug",
			"displayName": "Linux Debug",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "linux-release",
			"displayName": "Linux Release",
			"inherits": "linux-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "windows-base",
			"hidden": true,
			"inherits": "base",
			"description": "Microsoft Visual C++. Run from a \"x64 Native Tools Command Prompt for VS 2022\" so cl.exe and ninja are found.",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "windows-debug",
			"displayName": "Windows Debug (MSVC)",
			"inherits": "windows-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "windows-release",
			"displayName": "Windows Release (MSVC)",
			"inherits": "windows-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	],
	"buildPresets": [
		{ "name": "linux-debug", "configurePreset": "linux-debug" },
		{ "name": "linux-release", "configurePreset": "linux-release" },
		{ "name": "windows-debug", "configurePreset": "windows-debug" },
		{ "name": "windows-release", "configurePreset": "windows-release" }
	],
	"testPresets": [
		{
			"name": "test-base",
			"hidden": true,
			"output": { "outputOnFailure": true },
			"execution": { "noTestsAction": "error" }
		},
		{ "name": "linux-debug", "inherits": "test-base", "configurePreset": "linux-debug" },
		{ "name": "linux-release", "inherits": "test-base", "configurePreset": "linux-release" },
		{ "name": "windows-debug", "inherits": "test-base", "configurePreset": "windows-debug" },
		{ "name": "windows-release", "inherits": "test-base", "configurePreset": "windows-release" }
	],
	"workflowPresets": [
		{
			"name": "linux-debug",
			"displayName": "Linux Debug: configure, build, and test",
			"steps": [
				{ "type": "configure", "name": "linux-debug" },
				{ "type": "build", "name": "linux-debug" },
				{ "type": "test", "name": "linux-debug" }
			]
		},
		{
			"name": "linux-release",
			"displayName": "Linux Release: configure, build, and test",
			"steps": [
				{ "type": "configure", "name": "linux-release" },
				{ "type": "build", "name": "linux-release" },
				{ "type": "test", "name": "linux-release" }
			]
		},
		{
			"name": "windows-debug",
			"displayName": "Windows Debug: configure, build, and test",
			"steps": [
				{ "type": "configure", "name": "windows-debug" },
				{ "type": "build", "name": "windows-debug" },
				{ "type": "test", "name": "windows-debug" }
			]
		},
		{
			"name": "windows-release",
			"displayName": "Windows Release: configure, build, and test",
			"steps": [
				{ "type": "configure", "name": "windows-release" },
				{ "type": "build", "name": "windows-release" },
				{ "type": "test", "name": "windows-release" }
			]
		}
	]
}
