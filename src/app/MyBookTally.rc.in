// Windows resources for MyBookTally.exe. Generated by CMake from
// MyBookTally.rc.in; edit that file, not the generated copy.

#include <winver.h>

// The first icon in the file is the one Explorer shows for the .exe.
IDI_ICON1 ICON "@MYBOOKTALLY_ICO@"

VS_VERSION_INFO VERSIONINFO
	FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
	PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
	FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
	FILEFLAGS       0
	FILEOS          VOS_NT_WINDOWS32
	FILETYPE        VFT_APP
	FILESUBTYPE     VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		// 0409 = US English, 04B0 = Unicode.
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName",      "jeffcrone"
			VALUE "FileDescription",  "MyBookTally"
			VALUE "FileVersion",      "@PROJECT_VERSION@"
			VALUE "InternalName",     "MyBookTally"
			VALUE "LegalCopyright",   "Copyright (c) 2026 jeffcrone. MIT No Attribution License."
			VALUE "OriginalFilename", "MyBookTally.exe"
			VALUE "ProductName",      "MyBookTally"
			VALUE "ProductVersion",   "@PROJECT_VERSION@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
